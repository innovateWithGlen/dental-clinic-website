/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-DNS-Prefetch-Control: on
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cal.com https://*.cal.com; style-src 'self' 'unsafe-inline' https://cal.com https://*.cal.com; frame-src https://cal.com https://*.cal.com https://www.google.com; connect-src 'self' https://cal.com https://*.cal.com https://www.google.com; img-src 'self' data: https: blob:; font-src 'self' data: https:; worker-src 'self' blob:
